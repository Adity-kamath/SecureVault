# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# e.g., local MongoDB or MongoDB Atlas URI:
MONGO_URI=mongodb://127.0.0.1:27017/securevault

# JSON Web Token Secret & Expiration
# Use a strong, random 64+ char secret string
JWT_SECRET=securevault_jwt_secret_key_production_grade_random_hash_98234710
JWT_EXPIRES_IN=8h

# AES-256 Master Vault Key (MUST be 32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Origin (CORS whitelist)
CLIENT_URL=http://localhost:3000
